@prefix jp: <http://jewish_philosophy.org/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .

jp:Source_Wikidata a jp:Source ;
    rdfs:label "Wikidata" ;
    rdfs:comment "Data imported from Wikidata, including biographical data, coordinates, and basic identifiers." .

jp:Source_MARC a jp:Source ;
    rdfs:label "National Library MARC Data" ;
    rdfs:comment "Data extracted from the Israel National Library's MARC records." .

jp:Source_Harvey_Reports a jp:Source ;
    rdfs:label "Steven Harvey Reports" ;
    rdfs:comment "Data curated from Steven Harvey's periodic bibliographic reports on medieval Jewish philosophy." .

jp:Source_Freudenthal_Book a jp:Source ;
    rdfs:label "Freudenthal Book (2012)" ;
    rdfs:comment "Data extracted from 'Science in Medieval Jewish Cultures' (Gad Freudenthal, 2012)." .

jp:Source_Niran_Index a jp:Source ;
    rdfs:label "Niran's Index" ;
    rdfs:comment "An index of historical actors and works curated by Niran." .

jp:Source_Yossi_German_Paper a jp:Source ;
    rdfs:label "Yossi's German Paper" ;
    rdfs:comment "Data extracted from Yossi's paper on German Jewish philosophy." .

jp:Source_Wikipedia a jp:Source ;
    rdfs:label "Wikipedia" ;
    schema:url "https://en.wikipedia.org/" .

jp:Source_SEP a jp:Source ;
    rdfs:label "Stanford Encyclopedia of Philosophy" ;
    schema:url "https://plato.stanford.edu/" .

jp:Source_JE a jp:Source ;
    rdfs:label "Jewish Encyclopedia" ;
    schema:url "https://www.jewishencyclopedia.com/" .

jp:Source_Cambridge a jp:Source ;
    rdfs:label "Cambridge History of Jewish Philosophy" ;
    schema:url "https://www.cambridge.org/" .

jp:Source_SIEPM a jp:Source ;
    rdfs:label "SIEPM Reports" ;
    schema:url "https://example.org/siepm" .

jp:Source_KabHas a jp:Source ;
    rdfs:label "Kab/Has" ;
    schema:url "https://example.org/kabhas" .

jp:Source_NonJewish a jp:Source ;
    rdfs:label "Non‑Jewish" ;
    schema:url "https://example.org/nonjewish" .

jp:Source_Wikipedia schema:name "Wikipedia" .
jp:Source_SEP schema:name "Stanford Encyclopedia of Philosophy" .
jp:Source_JE schema:name "Jewish Encyclopedia" .
jp:Source_Cambridge schema:name "Cambridge History of Jewish Philosophy" .
jp:Source_SIEPM schema:name "SIEPM Reports" .
jp:Source_KabHas schema:name "Kab/Has" .
jp:Source_NonJewish schema:name "Non‑Jewish" .
jp:Source_Wikipedia rdfs:label "Wikipedia" .
jp:Source_SEP rdfs:label "Stanford Encyclopedia of Philosophy" .
jp:Source_JE rdfs:label "Jewish Encyclopedia" .
jp:Source_Cambridge rdfs:label "Cambridge History of Jewish Philosophy" .
jp:Source_SIEPM rdfs:label "SIEPM Reports" .
jp:Source_KabHas rdfs:label "Kab/Has" .
jp:Source_NonJewish rdfs:label "Non‑Jewish" .
